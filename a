  // Add button
  const addBtn=document.createElement('button');
  addBtn.style.cssText='background:#111;border:1px solid #222;border-radius:20px;padding:5px 12px;font-size:10px;color:#444;cursor:pointer;font-family:monospace;transition:all 0.2s';
  addBtn.textContent=state.panel==='add'?'cancel':'+ add';
  if(state.panel==='add'){addBtn.style.background='#e8ff3c';addBtn.style.color='#000';addBtn.style.borderColor='#e8ff3c';}
  addBtn.onclick=()=>{
    if(state.panel==='add'){state.panel=null;}
    else{state.panel='add';state.editId=null;}
    document.getElementById('panel-load').value=45;
    document.getElementById('panel-speed').value=1.0;
    renderAll();
  };
  cont.appendChild(addBtn);

  // Wire chip buttons
  cont.querySelectorAll('.edit-btn').forEach(b=>b.addEventListener('click',e=>{
    e.stopPropagation(); openEdit(parseInt(b.dataset.id));
  }));
  cont.querySelectorAll('.remove-btn').forEach(b=>b.addEventListener('click',e=>{
    e.stopPropagation(); removePoint(parseInt(b.dataset.id));
  }));

  // Panel
  const panel=document.getElementById('data-panel');
  const ptitle=document.getElementById('panel-title');
  const premove=document.getElementById('panel-remove');
  const pconfirm=document.getElementById('panel-confirm');
  const loadWrap=document.getElementById('load-input-wrap');
  if(state.panel==='add'){
    panel.style.display='block'; ptitle.textContent='New Test Point';
    premove.style.display='none'; pconfirm.textContent='Add Point';
    loadWrap.style.display='block';
  } else if(state.panel==='edit'){
    panel.style.display='block';
    const pt=state.dataPoints.find(p=>p.id===state.editId);
    ptitle.textContent=`Update ${pt?pt.load:0}lb Point`;
    premove.style.display=state.dataPoints.length>2?'block':'none';
    pconfirm.textContent='Update'; loadWrap.style.display='none';
  } else {
    panel.style.display='none';
  }
}

function openEdit(id){
  const pt=state.dataPoints.find(p=>p.id===id); if(!pt)return;
  state.panel='edit'; state.editId=id;
  document.getElementById('panel-speed').value=pt.v;
  renderAll();
}
function removePoint(id){
  if(state.dataPoints.length<=2)return;
  state.dataPoints=state.dataPoints.filter(p=>p.id!==id);
  if(state.editId===id){state.panel=null;state.editId=null;}
  renderAll(); save();
}

document.getElementById('panel-confirm').onclick=()=>{
  const speedVal=parseFloat(document.getElementById('panel-speed').value)||0;
  if(state.panel==='add'){
    const loadVal=parseFloat(document.getElementById('panel-load').value)||0;
    const exists=state.dataPoints.find(p=>p.load===loadVal);
    if(exists){exists.v=speedVal;}
    else{state.dataPoints.push({id:state.nextId++,load:loadVal,v:speedVal});}
  } else if(state.panel==='edit'){
    const pt=state.dataPoints.find(p=>p.id===state.editId);
    if(pt)pt.v=speedVal;
  }
  state.panel=null; state.editId=null;
  renderAll(); save();
};
document.getElementById('panel-cancel').onclick=()=>{state.panel=null;state.editId=null;renderAll();};
document.getElementById('panel-remove').onclick=()=>{removePoint(state.editId);};

