});

// ── Graph hover tooltip ───────────────────────────────────────────────────────
const graphTooltip = document.createElement('div');
graphTooltip.style.cssText=`
  position:fixed; display:none; pointer-events:none; z-index:999;
  background:#0a0a0a; border:1px solid #222; border-radius:8px;
  padding:10px 14px; font-family:'Courier New',monospace; font-size:11px;
  color:#eee; min-width:130px; line-height:1.8;
  box-shadow:0 4px 24px rgba(0,0,0,0.6);
`;
document.body.appendChild(graphTooltip);

graphCanvas.addEventListener('mousemove', e=>{
  if(!reg) return;
  const rect = graphCanvas.getBoundingClientRect();
  const mx = (e.clientX - rect.left) * (graphCanvas.width / rect.width);
  const my = (e.clientY - rect.top)  * (graphCanvas.height / rect.height);
  const maxLoad = Math.max(100, Math.ceil(reg.v0/reg.k/10)*10+10);
  const maxVel  = Math.max(4, Math.ceil(reg.v0*1.15));
  const pw = graphW - PAD.left - PAD.right;
  const ph = graphH - PAD.top  - PAD.bottom;

  // Only show inside plot area
  if(mx < PAD.left || mx > graphW-PAD.right || my < PAD.top || my > PAD.top+ph){
    graphTooltip.style.display='none'; return;
  }

  // Convert mouse x → load, then snap vel to curve at that load
  const hoverLoad = Math.max(0, ((mx - PAD.left) / pw) * maxLoad);
  const hoverVel  = Math.max(0, reg.v0 - reg.k * hoverLoad);
  if(hoverVel <= 0){ graphTooltip.style.display='none'; return; }

  // ── Correct extrapolation: treat (hoverLoad, hoverVel) as a test point
  // and extrapolate to zero-load using the existing slope k
  // v0_estimated = hoverVel + k * hoverLoad
  // For points ON the curve this always = reg.v0
  // For visual clarity we show vert varying with mouse position freely
  const mouseVel = Math.max(0, maxVel - ((my - PAD.top) / ph) * maxVel);
  const v0estimated = mouseVel + reg.k * hoverLoad;
  const predVert = vertFromAdj(Math.max(0, v0estimated) * state.cf);

  // Also show what curve says at this load
  const curveVert = vertFromAdj(reg.v0 * state.cf);

  // Check if hovering near a data point dot
  let dotLabel = '';
  for(const pt of state.dataPoints){
    const dpx = PAD.left + pt.load/maxLoad*pw;
    const dpy = PAD.top  + ph - pt.v/maxVel*ph;
    if(Math.hypot(mx-dpx, my-dpy) < 18){
      dotLabel = `<div style="color:#e8ff3c;font-weight:700;margin-bottom:4px">● ${pt.load}lb test point</div>`;
      break;
    }
  }

  graphTooltip.innerHTML = `
    ${dotLabel}
    <div style="color:#555">Load <span style="color:#fff;float:right;margin-left:20px">${hoverLoad.toFixed(0)} lb</span></div>
    <div style="color:#555">Curve speed <span style="color:#fff;float:right;margin-left:20px">${hoverVel.toFixed(3)} m/s</span></div>
    <div style="border-top:1px solid #1a1a1a;margin-top:6px;padding-top:6px">
      <div style="color:#555">BW pred vert <span style="color:#e8ff3c;float:right;margin-left:20px;font-weight:700">${curveVert.toFixed(1)}"</span></div>
      <div style="color:#333;font-size:9px;margin-top:3px">from LV profile zero-load v₀</div>
    </div>
  `;

  graphHoverLoad = hoverLoad;
  drawGraph();

  // Position tooltip near cursor, keep in viewport
  const tx = e.clientX + 14;
  const ty = e.clientY - 10;
  const tw = 175, th = 100;
  graphTooltip.style.left = (tx + tw > window.innerWidth ? e.clientX - tw - 14 : tx) + 'px';
  graphTooltip.style.top  = (ty + th > window.innerHeight ? e.clientY - th : ty) + 'px';
  graphTooltip.style.display = 'block';
});

graphCanvas.addEventListener('mouseleave', ()=>{
  graphTooltip.style.display='none';
  graphHoverLoad = null;
  drawGraph();
});
