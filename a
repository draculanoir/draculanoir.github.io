function renderChips(){
  const cont=document.getElementById('chips-container');
  cont.innerHTML='';
  const sorted=[...state.dataPoints].sort((a,b)=>a.load-b.load);
  for(const pt of sorted){
    const isSel=state.panel==='edit'&&state.editId===pt.id;
    const chip=document.createElement('div');
    chip.className='chip'+(isSel?' selected':'');
    chip.innerHTML=`<div class="chip-dot"></div>
      <span class="chip-load">${pt.load}lb</span>
      <span style="color:#555">·</span>
      <span class="chip-v" style="${isSel?'color:#e8ff3c':''}">${pt.v.toFixed(2)} m/s</span>
      <button class="chip-btn edit-btn" data-id="${pt.id}" title="edit">✎</button>
      ${state.dataPoints.length>2?`<button class="chip-btn remove remove-btn" data-id="${pt.id}" title="remove">×</button>`:''}`;
    cont.appendChild(chip);
