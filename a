// SIMULATION
// ─────────────────────────────────────────────────────────────────────────────
const SC=4.0, SW=500, SH=560, GY=510, FX=110, PX=380;
const simCanvas=document.getElementById('sim-canvas');
simCanvas.width=SW; simCanvas.height=SH;

const BP={head:18,neck:10,torso:76,thigh:62,shin:54,foot:14};
const mk=(x,y)=>({x,y});

const P_STAND={
  foot:mk(FX,GY), ankle:mk(FX,GY-BP.foot), knee:mk(FX,GY-BP.foot-BP.shin),
  hip:mk(FX,GY-BP.foot-BP.shin-BP.thigh), sh:mk(FX,GY-BP.foot-BP.shin-BP.thigh-BP.torso),
  neck:mk(FX,GY-BP.foot-BP.shin-BP.thigh-BP.torso-BP.neck),
  head:mk(FX,GY-BP.foot-BP.shin-BP.thigh-BP.torso-BP.neck-BP.head),
  fknee:mk(FX,GY-BP.foot-BP.shin), fankle:mk(FX,GY-BP.foot), ffoot:mk(FX,GY),
  elL:mk(FX-14,GY-BP.foot-BP.shin-BP.thigh-BP.torso+38),
  haL:mk(FX-16,GY-BP.foot-BP.shin-BP.thigh-BP.torso+78),
  elR:mk(FX+14,GY-BP.foot-BP.shin-BP.thigh-BP.torso+38),
  haR:mk(FX+16,GY-BP.foot-BP.shin-BP.thigh-BP.torso+78),
};
const hipY=GY-34;
const P_SQUAT={
  foot:mk(FX,GY), ankle:mk(FX,GY-10), knee:mk(FX+44,GY-28), hip:mk(FX+2,hipY),
  sh:mk(FX+4,hipY-80), neck:mk(FX+4,hipY-92), head:mk(FX+5,hipY-110),
  fknee:mk(FX+78,hipY-8), fankle:mk(FX+148,GY-16), ffoot:mk(FX+164,GY-8),
  elL:mk(FX-12,hipY-58), haL:mk(FX-8,hipY-36),
  elR:mk(FX+20,hipY-58), haR:mk(FX+16,hipY-36),
};
const P_LAND={
  foot:mk(FX,GY), ankle:mk(FX,GY-12), knee:mk(FX+10,GY-58), hip:mk(FX+4,GY-114),
  sh:mk(FX+3,GY-192), neck:mk(FX+3,GY-204), head:mk(FX+3,GY-222),
  fknee:mk(FX+10,GY-58), fankle:mk(FX+6,GY-12), ffoot:mk(FX+6,GY),
  elL:mk(FX-16,GY-158), haL:mk(FX-22,GY-122),
  elR:mk(FX+22,GY-158), haR:mk(FX+28,GY-122),
};

function makeAirPose(vertIn){
  const lift=vertIn*SC;
  const up=(p,dx=0,dy=0)=>mk(p.x+dx,p.y-lift+dy);
  return{
    foot:up(P_STAND.foot), ankle:up(P_STAND.ankle,0,8), knee:up(P_STAND.knee,4,16),
    hip:up(P_STAND.hip), sh:up(P_STAND.sh), neck:up(P_STAND.neck), head:up(P_STAND.head),
    fknee:up(P_STAND.fknee,4,16), fankle:up(P_STAND.fankle,3,8), ffoot:up(P_STAND.ffoot,3),
    elL:up(P_STAND.elL,-4,-14), haL:up(P_STAND.haL,-6,-26),
    elR:up(P_STAND.elR,4,-14), haR:up(P_STAND.haR,6,-26),
  };
}

function lerpPose(a,b,t){
  const r={};
  for(const k of Object.keys(a)) r[k]={x:a[k].x+(b[k].x-a[k].x)*t, y:a[k].y+(b[k].y-a[k].y)*t};
  return r;
}
const eio=t=>t<0.5?2*t*t:-1+(4-2*t)*t;
const eo=t=>1-(1-t)*(1-t);

function getSimPose(t, airPose){
  if(t<0.20) return P_SQUAT;
  if(t<0.42) return lerpPose(P_SQUAT,P_STAND,eio((t-0.20)/0.22));
  if(t<0.55) return lerpPose(P_STAND,airPose,eo((t-0.42)/0.13));
  if(t<0.68) return lerpPose(airPose,P_STAND,eio((t-0.55)/0.13));
  if(t<0.80) return lerpPose(P_STAND,P_LAND,eo((t-0.68)/0.12));
  return lerpPose(P_LAND,P_SQUAT,eio((t-0.80)/0.20));
}

let simPlaying=false, simT=0, simLast=null, simRaf=null;

function drawSim(t){
  const ctx=simCanvas.getContext('2d');
  const cw=simCanvas.width;
  const PL=cw-72; // dynamic plate center - always 72px from right edge
  ctx.fillStyle='#060606'; ctx.fillRect(0,0,cw,SH);

  // Ground
  ctx.strokeStyle='#1e1e1e'; ctx.lineWidth=2;
  ctx.beginPath(); ctx.moveTo(0,GY+1); ctx.lineTo(cw,GY+1); ctx.stroke();
  ctx.strokeStyle='#111'; ctx.lineWidth=1;
  for(let x=-10;x<cw+10;x+=14){ctx.beginPath();ctx.moveTo(x,GY+1);ctx.lineTo(x-12,GY+14);ctx.stroke();}

  // Height scale (right edge)
  for(let i=6;i<=60;i+=6){
    const y=GY-i*SC; if(y<30)break;
    ctx.strokeStyle='#1a1a1a'; ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(cw-10,y);ctx.lineTo(cw-4,y);ctx.stroke();
    if(i%12===0){ctx.fillStyle='#1e1e1e';ctx.font='7px monospace';ctx.textAlign='right';ctx.fillText(i+'"',cw-12,y+3);}
  }

  // Predicted vert from formula (zero-load LV profile × CF)
  const vertIn = reg ? vertFromAdj(reg.v0 * state.cf) : 0;

  // Predicted vert label top left
  ctx.fillStyle='rgba(232,255,60,0.35)'; ctx.font='8px monospace'; ctx.textAlign='left';
  ctx.fillText('PREDICTED VERT: '+vertIn.toFixed(1)+'"', 32, 18);

  // Vert dashed line
  if(vertIn>0){
    const vy=GY-vertIn*SC;
    if(vy>26){
      ctx.strokeStyle='rgba(232,255,60,0.25)'; ctx.lineWidth=1; ctx.setLineDash([4,4]);
      ctx.beginPath(); ctx.moveTo(32,vy); ctx.lineTo(cw-16,vy); ctx.stroke(); ctx.setLineDash([]);
      ctx.fillStyle='rgba(232,255,60,0.6)'; ctx.font='8px monospace'; ctx.textAlign='left';
      ctx.fillText(vertIn.toFixed(1)+'"',34,vy-3);
    }
  }

  // Height bracket (left)
  ctx.strokeStyle='#181818'; ctx.lineWidth=1;
  const figH=BP.foot+BP.shin+BP.thigh+BP.torso+BP.neck+BP.head*2;
  ctx.beginPath(); ctx.moveTo(22,GY); ctx.lineTo(22,GY-figH); ctx.stroke();
  ctx.beginPath();ctx.moveTo(19,GY);ctx.lineTo(25,GY);ctx.stroke();
  ctx.beginPath();ctx.moveTo(19,GY-figH);ctx.lineTo(25,GY-figH);ctx.stroke();
  ctx.save(); ctx.translate(14,GY-figH/2); ctx.rotate(-Math.PI/2);
  ctx.fillStyle='#1a1a1a'; ctx.font='7px monospace'; ctx.textAlign='center';
  ctx.fillText("171cm / 5'7\"",0,0); ctx.restore();

  // PLATES — stacked next to figure, all within canvas
  let plateY=GY;
  const allZero=state.plateStacks.every(s=>s.count===0);
  if(!allZero){
    for(const {weight,count} of state.plateStacks){
      if(count===0)continue;
      const spec=PLATE_SPECS[weight];
      const thPx=spec.thickIn*SC;
      const halfW=spec.widthPx/2;
      // Clamp so plate never goes out of canvas
      const px=Math.min(PL, cw-halfW-4);
      for(let i=0;i<count;i++){
        const py=plateY-thPx;
        const g=ctx.createLinearGradient(px-halfW,py,px+halfW,py);
        g.addColorStop(0,'#1e1e1e'); g.addColorStop(0.5,'#2c2c2c'); g.addColorStop(1,'#181818');
        ctx.fillStyle=g;
        ctx.beginPath(); ctx.roundRect(px-halfW,py+0.5,spec.widthPx,thPx-1,2); ctx.fill();
        ctx.strokeStyle='#333'; ctx.lineWidth=0.5;
        ctx.strokeRect(px-halfW,py+0.5,spec.widthPx,thPx-1);
        const fs=Math.max(6,thPx*0.5);
        ctx.fillStyle='#3a3a3a'; ctx.font=`bold ${fs}px monospace`; ctx.textAlign='center';
        ctx.fillText(spec.label,px,py+thPx/2+fs*0.35);
        plateY=py;
      }
    }
    const totalH=GY-plateY;
    if(totalH>0){
      const px=Math.min(PL, cw-PLATE_SPECS[45].widthPx/2-4);
      ctx.fillStyle='#444'; ctx.font='9px monospace'; ctx.textAlign='center';
      ctx.fillText((totalH/SC).toFixed(2)+'"',px,plateY-7);
      const clearance=vertIn*SC-totalH;
      ctx.fillStyle=clearance>=0?'rgba(57,255,159,0.8)':'rgba(255,77,77,0.8)';
      ctx.font='8px monospace';
      ctx.fillText(clearance>=0?'+'+((clearance/SC).toFixed(1))+'" clear':((clearance/SC).toFixed(1))+'" short',px,plateY-18);
      // vertical bracket
      const bx=px-PLATE_SPECS[45].widthPx/2-8;
      ctx.strokeStyle='#2a2a2a'; ctx.lineWidth=1;
      ctx.beginPath(); ctx.moveTo(bx,GY); ctx.lineTo(bx,plateY); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(bx-3,GY); ctx.lineTo(bx+3,GY); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(bx-3,plateY); ctx.lineTo(bx+3,plateY); ctx.stroke();
    }
  }

  // FIGURE — uses formula zero-load vert
  const airPose=makeAirPose(vertIn);
  const pose=getSimPose(t,airPose);
  const ln=(a,b,w=2.5)=>{ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.lineWidth=w;ctx.stroke();};

  ctx.strokeStyle='#e8ff3c'; ctx.fillStyle='#e8ff3c'; ctx.lineCap='round'; ctx.lineJoin='round';

  if(pose.foot.y>GY-22){
    ctx.globalAlpha=0.1; ctx.beginPath();ctx.ellipse(pose.foot.x,GY+3,18,4,0,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;
  }

  ctx.strokeStyle='#e8ff3c';
  ctx.beginPath();ctx.moveTo(pose.foot.x-11,pose.foot.y);ctx.lineTo(pose.foot.x+6,pose.foot.y);ctx.lineWidth=2.5;ctx.stroke();
  ln(pose.foot,pose.ankle); ln(pose.ankle,pose.knee); ln(pose.knee,pose.hip);

  ctx.globalAlpha=0.75;
  ln(pose.hip,pose.fknee); ln(pose.fknee,pose.fankle); ln(pose.fankle,pose.ffoot);
  ctx.globalAlpha=1;

  ln(pose.hip,pose.sh); ln(pose.sh,pose.neck,2);

  const shL={x:pose.sh.x-10,y:pose.sh.y}, shR={x:pose.sh.x+10,y:pose.sh.y};
  ln(shL,pose.elL,2); ln(pose.elL,pose.haL,2);
  ln(shR,pose.elR,2); ln(pose.elR,pose.haR,2);

  ctx.beginPath();ctx.arc(pose.head.x,pose.head.y,18,0,Math.PI*2);ctx.lineWidth=2.5;ctx.stroke();

  ctx.fillStyle='#e8ff3c';
  for(const p of [pose.knee,pose.hip,pose.sh]){ctx.beginPath();ctx.arc(p.x,p.y,3,0,Math.PI*2);ctx.fill();}

  if(simPlaying){
    const phase=t<0.20?"FULL DEPTH":t<0.42?"DRIVE":t<0.55?"AIRBORNE ↑":t<0.68?"AIRBORNE ↓":t<0.80?"LANDING":"ABSORB";
    ctx.fillStyle='rgba(232,255,60,0.4)'; ctx.font='8px monospace'; ctx.textAlign='center';
    ctx.fillText(phase,FX+60,28);
  }
}

// helper for plate hw
function hw(w){return (PLATE_SPECS[w]||{widthPx:50}).widthPx/2;}

function simAnimate(ts){
  if(!simPlaying)return;
  if(!simLast)simLast=ts;
  const dt=(ts-simLast)/1000; simLast=ts;
  simT=(simT+dt/2.8)%1;
  drawSim(simT);
  simRaf=requestAnimationFrame(simAnimate);
}

const playBtn=document.getElementById('play-btn');
playBtn.onclick=()=>{
  simPlaying=!simPlaying;
  if(simPlaying){
    playBtn.textContent='⏸ PAUSE';
    playBtn.style.background='#1a1a0a'; playBtn.style.color='#e8ff3c';
    playBtn.style.borderColor='rgba(232,255,60,0.3)';
    simLast=null; simRaf=requestAnimationFrame(simAnimate);
  } else {
    playBtn.textContent='▶ PLAY';
    playBtn.style.background='#e8ff3c'; playBtn.style.color='#000';
    playBtn.style.borderColor='#e8ff3c';
    cancelAnimationFrame(simRaf);
  }
};

// Build plate controls
function buildPlateControls(){
  const grid=document.getElementById('plates-grid');
  grid.innerHTML='';
  for(let i=0;i<state.plateStacks.length;i++){
    const {weight,count}=state.plateStacks[i];
    const spec=PLATE_SPECS[weight];
    const card=document.createElement('div'); card.className='plate-card';
    card.innerHTML=`
      <div class="plate-card-top">
        <div><span class="plate-name">${weight}lb</span><span class="plate-thick">${spec.thickIn}"ea</span></div>
        <span class="plate-count" id="pc-${weight}">${count}</span>
      </div>
      <div class="plate-btns">
        <button class="plate-btn" id="pm-${weight}">−</button>
        <button class="plate-btn plus" id="pp-${weight}">+</button>
      </div>`;
    grid.appendChild(card);
    document.getElementById('pm-'+weight).onclick=()=>{
      state.plateStacks[i].count=Math.max(0,state.plateStacks[i].count-1);
      document.getElementById('pc-'+weight).textContent=state.plateStacks[i].count;
      updateStackInfo(); if(!simPlaying)drawSim(simT); save();
    };
    document.getElementById('pp-'+weight).onclick=()=>{
      state.plateStacks[i].count=Math.min(12,state.plateStacks[i].count+1);
      document.getElementById('pc-'+weight).textContent=state.plateStacks[i].count;
      updateStackInfo(); if(!simPlaying)drawSim(simT); save();
    };
  }
}

function updateStackInfo(){
  const totalH=state.plateStacks.reduce((a,{weight,count})=>a+(PLATE_SPECS[weight].thickIn*count),0);
  const info=document.getElementById('stack-info');
  const vert=computedVert();
  if(totalH===0){info.style.display='none';return;}
  info.style.display='block';
  const diff=vert-totalH;
  info.innerHTML=`<span style="color:#444">Stack: </span><span style="color:#fff">${totalH.toFixed(2)}"</span>
    <span style="color:#333;margin:0 8px">·</span>
    ${diff>=0
      ?`<span style="color:#39ff9f">✓ clears by ${diff.toFixed(2)}"</span>`
      :`<span style="color:#ff4d4d">✗ ${Math.abs(diff).toFixed(2)}" short</span>`}`;
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPUTED
// ─────────────────────────────────────────────────────────────────────────────
function computedVert(){
  if(!reg)return 0;
  // True predicted BW vert = zero-load v0 from regression × CF
  return vertFromAdj(reg.v0*state.cf);
}

// ─────────────────────────────────────────────────────────────────────────────
// RENDER ALL
// ─────────────────────────────────────────────────────────────────────────────
function renderAll(){
  reg=linReg(state.dataPoints);
  if(!reg)return;
  const {k,v0,r2}=reg;

  const v0user=state.speed+k*state.load;
  const vert=vertFromAdj(v0user*state.cf);
  const needed=needSpeed(state.targetVert,k,state.load,state.cf);
  const gap=Math.max(0,needed-state.speed);
  const vertPct=Math.min(100,(vert/state.targetVert)*100);
  const speedPct=Math.min(100,(state.speed/needed)*100);
  const vertColor=vertPct<40?'#ff4d4d':vertPct<75?'#ff8c00':'#e8ff3c';
  const status=getStatus(vert);

  // Gauge
  drawGauge(vert,state.targetVert,vertColor);

  // Gauge info
  document.getElementById('adj-v0').textContent=(v0user*state.cf).toFixed(3)+' m/s';
  document.getElementById('need-label').textContent=`NEED @ ${state.load}LB → ${state.targetVert}"`;
  const needEl=document.getElementById('need-val');
  needEl.textContent=needed.toFixed(2)+' m/s';
  needEl.style.color=gap===0?'#39ff9f':'#ff4d4d';
  const gapEl=document.getElementById('gap-label');
  gapEl.textContent=gap===0?'✓ target hit':`+${gap.toFixed(2)} m/s gap`;
  gapEl.style.color=gap===0?'#39ff9f':'#666';

  // Status
  document.getElementById('status-label').textContent=status.label;
  document.getElementById('status-label').style.color=status.color;

  // Sliders sync
  syncSlider(document.getElementById('load-slider'),document.getElementById('load-fill'),document.getElementById('load-thumb'),5,200);
  syncSlider(document.getElementById('speed-slider'),document.getElementById('speed-fill'),document.getElementById('speed-thumb'),0.3,4.5);
  syncSlider(document.getElementById('cf-slider'),document.getElementById('cf-fill'),document.getElementById('cf-thumb'),0.80,0.97);
  syncSlider(document.getElementById('target-slider'),document.getElementById('target-fill'),document.getElementById('target-thumb'),2,50);
  document.getElementById('load-val').innerHTML=state.load+'<span class="slider-unit">lb</span>';
  document.getElementById('speed-val').innerHTML=state.speed.toFixed(2)+'<span class="slider-unit">m/s</span>';
  document.getElementById('cf-val').textContent=state.cf.toFixed(2);
  document.getElementById('cf-sub').textContent=getCfLabel(state.cf);
  document.getElementById('target-val').innerHTML=state.targetVert+'<span class="slider-unit">"</span>';
  document.getElementById('target-display').textContent=state.targetVert;

  // Progress bar
  document.getElementById('speed-pct').textContent=speedPct.toFixed(0)+'%';
  const prog=document.getElementById('speed-prog');
  prog.style.width=speedPct+'%';
  prog.style.background=gap===0?'#e8ff3c':'linear-gradient(90deg,#ff4d4d,#ff8c00)';

  // Stats
  document.getElementById('hdr-k').textContent='k = '+k.toFixed(4);
  document.getElementById('hdr-r2').textContent='R² = '+r2.toFixed(3);
  document.getElementById('stat-k').textContent=k.toFixed(4);
  document.getElementById('stat-v0').textContent=v0.toFixed(3)+' m/s';
  document.getElementById('stat-cf').textContent=state.cf.toFixed(2);
  document.getElementById('graph-eq').textContent=`v = ${v0.toFixed(3)} − ${k.toFixed(4)} × load`;
  document.getElementById('graph-r2').textContent='R² '+r2.toFixed(3);

  // Sim label — show zero-load predicted vert
  document.getElementById('sim-vert-label').textContent=reg?vertFromAdj(reg.v0*state.cf).toFixed(1):'—';

  // Graph
  drawGraph();

  // Chips
  renderChips();

  // Stack info
  updateStackInfo();

  // Sim (static)
  if(!simPlaying) drawSim(simT);
}

// ─────────────────────────────────────────────────────────────────────────────
// WIRE INPUTS
// ─────────────────────────────────────────────────────────────────────────────
document.getElementById('load-slider').oninput=e=>{state.load=parseFloat(e.target.value);renderAll();save();};
document.getElementById('speed-slider').oninput=e=>{state.speed=parseFloat(e.target.value);renderAll();save();};
document.getElementById('cf-slider').oninput=e=>{state.cf=parseFloat(e.target.value);renderAll();save();};
document.getElementById('target-slider').oninput=e=>{state.targetVert=parseInt(e.target.value);renderAll();save();};

const targetToggle=document.getElementById('target-toggle');
const targetPanel=document.getElementById('target-panel');
targetToggle.onclick=()=>{
  const open=targetPanel.style.display==='block';
  targetPanel.style.display=open?'none':'block';
  targetToggle.textContent=open?'+':'−';
  targetToggle.style.background=open?'#161616':'#e8ff3c';
  targetToggle.style.color=open?'#555':'#000';
};

// ─────────────────────────────────────────────────────────────────────────────
// CANVAS RESIZE
// ─────────────────────────────────────────────────────────────────────────────
function resizeCanvases(){
  const cardW=Math.min(500,window.innerWidth-32);
  graphCanvas.width=cardW-0;
  graphW=graphCanvas.width;
  simCanvas.width=cardW;
  renderAll();
}
window.addEventListener('resize',()=>resizeCanvases());

// ─────────────────────────────────────────────────────────────────────────────
// INIT
// ─────────────────────────────────────────────────────────────────────────────
buildPlateControls();
resizeCanvases();

// Restore target panel open state
if(state.targetOpen){
  document.getElementById('target-panel').style.display='block';
  const btn=document.getElementById('target-toggle');
  btn.textContent='−'; btn.style.background='#e8ff3c'; btn.style.color='#000';
}

// ─────────────────────────────────────────────────────────────────────────────
// WELCOME VOICE
// ─────────────────────────────────────────────────────────────────────────────
function speakWelcome(){
  if(!window.speechSynthesis) return;
  window.speechSynthesis.cancel();

  const vert = reg ? vertFromAdj(reg.v0*state.cf) : 0;
  const status = reg ? getStatus(vert) : null;

  const msg = isReturningUser
    ? `Welcome back. Your load velocity profile is loaded. Current predicted pistol vert is ${vert.toFixed(1)} inches. Status: ${status?.label || 'unknown'}.`
    : `Welcome to the Pistol Squat Calculator. Add your test data points to build your load velocity profile and predict your vertical.`;

  const utter = new SpeechSynthesisUtterance(msg);
  utter.rate  = 0.92;
  utter.pitch = 0.88;
  utter.volume= 1.0;

  // Pick a good voice — prefer a deep English one
  function speak(voices){
    const preferred = [
      'Google UK English Male',
      'Microsoft David Desktop',
      'Alex',
      'Daniel',
      'Google US English',
    ];
    const found = preferred.reduce((best, name) => {
      const v = voices.find(v => v.name === name);
      return (!best && v) ? v : best;
    }, null) || voices.find(v => v.lang.startsWith('en')) || voices[0];
    if(found) utter.voice = found;
    window.speechSynthesis.speak(utter);
  }

  const voices = window.speechSynthesis.getVoices();
  if(voices.length > 0){
    speak(voices);
  } else {
    // Voices not loaded yet — wait for them
    window.speechSynthesis.onvoiceschanged = () => {
      speak(window.speechSynthesis.getVoices());
      window.speechSynthesis.onvoiceschanged = null;
    };
  }
}

// Small delay so page renders first, then voice fires
setTimeout(speakWelcome, 800);
